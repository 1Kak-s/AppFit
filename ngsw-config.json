{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/*.png"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "config",
      "urls": ["/config.json"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 1, "maxAge": "30d", "timeout": "3s" }
    }
  ]
}
